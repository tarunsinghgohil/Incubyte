{
  "name": "acme-compensation-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "seed": "tsx server/seed.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts"
  },
  "dependencies": { "@vitejs/plugin-react": "^5.0.4", "better-sqlite3": "^12.6.2", "cors": "^2.8.5", "express": "^5.1.0", "react": "^19.2.0", "react-dom": "^19.2.0", "zod": "^4.1.12" },
  "devDependencies": { "@types/better-sqlite3": "^7.6.13", "@types/cors": "^2.8.19", "@types/express": "^5.0.3", "@types/node": "^24.10.0", "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2", "@types/supertest": "^6.0.3", "concurrently": "^9.2.1", "supertest": "^7.1.4", "tsx": "^4.20.6", "typescript": "^5.9.3", "vite": "^7.1.12", "vitest": "^4.0.8" }
}
